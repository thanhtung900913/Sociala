KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Replace with the exact topic shown in Kafka UI, normally <topic.prefix>.public.posts.
KAFKA_TOPIC=REPLACE_WITH_EXACT_POSTS_TOPIC
KAFKA_GROUP_ID=feed-fanout-v1

# PRIMARY PostgreSQL, reachable from the worker container. URL-encode password characters.
PG_DSN=postgresql://feed_worker:CHANGE_ME@host.docker.internal:5432/social_app

AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=user_feeds
# Local development only: supply your own credentials using Boto3's credential chain.
# For temporary credentials all three values are needed. Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# friends sends to the author and accepted friends, subject to database policy.
# self_test sends ONLY to the author; custom_sql uses RECIPIENTS_SQL_FILE.
RECIPIENT_MODE=friends
# Relative paths are resolved from the feed-worker directory, regardless of cwd.
RECIPIENTS_SQL_FILE=sql/recipients.sql

# false ignores initial snapshot records (op=r); c/u records in Kafka retention
# will still be replayed when the consumer group has no committed offsets.
PROCESS_SNAPSHOTS=false
# 0 disables TTL. Positive value retains references for this many days from post creation.
RETENTION_DAYS=0
# Limits fail explicitly, never silently truncate recipients.
MAX_RECIPIENTS_PER_EVENT=5000
PROCESSING_TIMEOUT_SECONDS=120
