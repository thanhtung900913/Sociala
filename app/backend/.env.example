SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=
JWT_REFRESH_TOKEN_EXPIRES=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Same region and table as feed-worker. Backend IAM needs dynamodb:Query only.
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=user_feeds
# Boto3 uses its standard credential chain; use an IAM role in production.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Maximum evaluated references per request: page size * query pages.
FEED_QUERY_PAGE_SIZE=100
FEED_MAX_QUERY_PAGES=10
