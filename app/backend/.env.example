SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=
JWT_REFRESH_TOKEN_EXPIRES=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Same region and table as feed-worker. Backend IAM needs dynamodb:Query only.
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=user_feeds
# Boto3 uses its standard credential chain; use an IAM role in production.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Maximum evaluated references per request: page size * query pages.
FEED_QUERY_PAGE_SIZE=100
FEED_MAX_QUERY_PAGES=10

# Media API and Celery worker must use the same S3 storage and Redis broker.
STORAGE_PROVIDER=MINIO
MEDIA_BUCKET=user-media
MEDIA_EXPIRES_IN=600
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BROKER_DB=2
